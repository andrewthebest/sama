{
  "name": "@sama-emi/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend Vue 3 de SAMA EMI — choix scénario/parcours, formulaire de cadrage, suivi de génération, aperçu de document.",
  "type": "module",
  "scripts": {
