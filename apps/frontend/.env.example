# Mode démonstration : intercepte les appels réseau via MSW, aucun backend requis.
# Mettre à "true" pour développer/démontrer sans base de données ni backend actif.
VITE_USE_MOCKS=false

# Mode connecté : URL du backend NestJS réel.
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000/generation
