# ---------------------------------------------------------------------------
# SAMA EMI — variables d'environnement (backend)
# Copier ce fichier en .env et ajuster les valeurs pour le mode connecté.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (docker compose expose ces identifiants par défaut)
DATABASE_URL="postgresql://sama_emi:sama_emi_dev@localhost:5432/sama_emi?schema=public"

# Redis (file d'attente BullMQ pour le moteur de génération)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"

# API Anthropic (moteur de génération réel — tool use forcé, voir
# apps/backend/src/modules/generation/README.md). Sans clé, le moteur
# échoue proprement et de façon non transitoire dès le premier job.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Port HTTP du backend NestJS
PORT=3000

# Origine autorisée pour le frontend (CORS)
FRONTEND_ORIGIN="http://localhost:5173"
